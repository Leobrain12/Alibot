# Скопируйте в .env на сервере и заполните реальными значениями.
# .env НЕ должен попадать в git — уже добавлен в .gitignore.

# --- База данных ---
DB_USER=alibot
DB_PASSWORD=замените-на-длинный-случайный-пароль

# --- Telegram-бот ---
TELEGRAM_BOT_TOKEN=токен-от-BotFather
TELEGRAM_BOT_USERNAME=RepairTestaAakaBot

# polling — проще для старта, ничего дополнительно не требует.
# webhook — переключите ПОСЛЕ того, как настроите nginx+HTTPS (см. deploy/README.md шаг 5),
# и обязательно задайте TELEGRAM_WEBHOOK_BASE_URL + TELEGRAM_WEBHOOK_SECRET.
BOT_MODE=polling
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=

# --- Первый пользователь системы ---
# telegram_user_id, который получит роль SUPERADMIN при первом запуске на пустой БД.
SUPERADMIN_TELEGRAM_ID=

# --- Internal API (сайт/CRM/Mini App) ---
INTERNAL_API_KEY=замените-на-длинный-случайный-ключ

# --- Mini App ---
# Появится после того, как получите домен и настроите HTTPS — до этого можно оставить пустым,
# тогда бот просто не покажет кнопку "Открыть Mini App" (см. BotBootstrap).
MINI_APP_BASE_URL=

# --- CRM (ТЗ п.85-87) ---
# Пусто по умолчанию: события заказов никуда не отправляются и не копятся в очереди.
# Задайте, когда появится реальная CRM с приёмным вебхуком — доставка идёт с ретраями
# (2/10/30/120 минут, дальше запись остаётся в очереди как FAILED для ручного повтора через
# GET/POST /api/v1/crm-sync/...).
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# --- Срок хранения медиа (ТЗ п.100) ---
# 0 по умолчанию — хранить бессрочно. Удаление файлов необратимо, включайте осознанно.
# При N > 0 фотографии/видео заказов старше N дней удаляются с диска по ночному расписанию
# (сама запись в истории заказа остаётся — виден факт "медиа было", не содержимое).
MEDIA_RETENTION_DAYS=0
MEDIA_RETENTION_CRON=0 0 3 * * *
